      "ch01": {"id": "v02_n", "focus": false},
      "ch02": {"id": "v01_n", "focus": false},
      "ch03": {"id": "v03_s", "focus": false},
      "sound": "run",
      "name": "",
      "talk": "遠方傳來密集的腳步聲。"
