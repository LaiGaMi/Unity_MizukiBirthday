	{
      "background": "BG04",
      "ch01": {"id": "000", "focus": true},
      "ch02": {"id": "mfy_n", "focus": true},
      "ch03": {"id": "000", "focus": true},
      "name": "真冬",
      "talk": "……是鈴和連。"
