    {
      "background": "BG04",
      "ch01": {"id": "mzk_s", "focus": true},
      "ch02": {"id": "000", "focus": true},
      "ch03": {"id": "mfy_n", "focus": true},
      "name": "真冬",
      "talk": "……它們來了。"
