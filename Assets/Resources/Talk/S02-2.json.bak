    {
      "background": "BG04",
      "ch01": {"id": "000", "focus": true},
      "ch02": {"id": "v04_r", "focus": true},
      "ch03": {"id": "000", "focus": true},
      "name": "鏡音鈴",
      "talk": "……誰來……"
