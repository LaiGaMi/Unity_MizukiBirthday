      "ch01": {"id": "mzk_b", "focus": true},
      "ch02": {"id": "000", "focus": true},
      "ch03": {"id": "mfy_n", "focus": true},
      "name": "瑞希",
      "talk": "而且這裡的心願……感覺好混亂。"
