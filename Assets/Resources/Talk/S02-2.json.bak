      "ch01": {"id": "mzk_o", "focus": true},
      "ch02": {"id": "000", "focus": true},
      "ch03": {"id": "mfy_n", "focus": true},
      "name": "真冬",
      "talk": "可是……好像被破壞得很嚴重。"
