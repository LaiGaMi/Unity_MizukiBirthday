    {
      "background": "BG04",
      "ch01": {"id": "000", "focus": true},
      "ch02": {"id": "mzk_b", "focus": true},
      "ch03": {"id": "000", "focus": true},
      "name": "瑞希",
      "talk": "看起來……全都是失控的驚喜們。"
