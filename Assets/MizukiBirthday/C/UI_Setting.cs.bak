using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class UI_Setting : MonoBehaviour
{
    // =========================================================
    // 設定選單
    // =========================================================

    [Header("設定選單")]

    // 設定選單整個 Panel
    public GameObject settingsPanel;


    // =========================================================
    // 設定 Button
    // =========================================================

    [Header("設定 Button")]

    // 點擊後開啟 / 關閉設定
    public Button settingsButton;


    // =========================================================
    // 關閉 Button
    // =========================================================

    [Header("關閉 Button")]

    // 設定選單裡面的關閉按鈕
    public Button closeButton;


    // =========================================================
    // 音量 Slider
    // =========================================================

    [Header("音量設定")]

    // 背景音樂音量
    public Slider musicVolumeSlider;

    // 音效音量
    public Slider seVolumeSlider;


    // =========================================================
    // 初始化
    // =========================================================

    private void Start()
    {
        // -----------------------------------------------------
        // 綁定 Button
        // -----------------------------------------------------

        if (settingsButton != null)
        {
            settingsButton.onClick.AddListener(ToggleSettings);
        }

        if (closeButton != null)
        {
            closeButton.onClick.AddListener(CloseSettings);
        }


        // -----------------------------------------------------
        // 綁定 Slider
        // -----------------------------------------------------

        if (musicVolumeSlider != null)
        {
            musicVolumeSlider.onValueChanged.AddListener(
                OnMusicVolumeChanged
            );
        }

        if (seVolumeSlider != null)
        {
            seVolumeSlider.onValueChanged.AddListener(
                OnSEVolumeChanged
            );
        }


        // -----------------------------------------------------
        // 一開始關閉設定選單
        // -----------------------------------------------------

        if (settingsPanel != null)
        {
            settingsPanel.SetActive(false);
        }
    }


    // =========================================================
    // 開啟 / 關閉設定
    // =========================================================

    public void ToggleSettings()
    {
        if (settingsPanel == null)
        {
            return;
        }


        // -----------------------------------------------------
        // 如果目前是關閉
        // -----------------------------------------------------

        if (!settingsPanel.activeSelf)
        {
            OpenSettings();
        }
        else
        {
            CloseSettings();
        }
    }


    // =========================================================
    // 開啟設定
    // =========================================================

    public void OpenSettings()
    {
        if (settingsPanel == null)
        {
            return;
        }


        // -----------------------------------------------------
        // 顯示設定選單
        // -----------------------------------------------------

        settingsPanel.SetActive(true);


        // -----------------------------------------------------
        // 將目前 mizuki 的音量設定到 Slider
        // -----------------------------------------------------

        if (musicVolumeSlider != null)
        {
            musicVolumeSlider.value =
                mizuki.musicVolume;
        }

        if (seVolumeSlider != null)
        {
            seVolumeSlider.value =
                mizuki.seVolume;
        }


        // -----------------------------------------------------
        // 暫停遊戲
        // -----------------------------------------------------

        Time.timeScale = 0f;


        Debug.Log("設定選單開啟，遊戲暫停。");
    }


    // =========================================================
    // 關閉設定
    // =========================================================

    public void CloseSettings()
    {
        if (settingsPanel == null)
        {
            return;
        }


        // -----------------------------------------------------
        // 關閉設定選單
        // -----------------------------------------------------

        settingsPanel.SetActive(false);


        // -----------------------------------------------------
        // 恢復遊戲
        // -----------------------------------------------------

        Time.timeScale = 1f;


        Debug.Log("設定選單關閉，遊戲恢復。");
    }


    // =========================================================
    // 音樂音量改變
    // =========================================================

    private void OnMusicVolumeChanged(float value)
    {
        // -----------------------------------------------------
        // 即時更新 mizuki 的音樂音量
        // -----------------------------------------------------

        mizuki.musicVolume = value;


        Debug.Log(
            "音樂音量：" +
            mizuki.musicVolume
        );
    }


    // =========================================================
    // 音效音量改變
    // =========================================================

    private void OnSEVolumeChanged(float value)
    {
        // -----------------------------------------------------
        // 即時更新 mizuki 的音效音量
        // -----------------------------------------------------

        mizuki.seVolume = value;


        Debug.Log(
            "音效音量：" +
            mizuki.seVolume
        );
    }


    // =========================================================
    // 防止物件被刪除時遊戲維持暫停
    // =========================================================

    private void OnDestroy()
    {
        // 如果這個設定物件被刪除
        // 確保遊戲恢復正常速度
        Time.timeScale = 1f;
    }
}
