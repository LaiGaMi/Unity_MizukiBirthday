using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class V_Move2 : MonoBehaviour
{
    [Header("Movement")]
    [SerializeField] private float speed = 3f;

    // 實際使用中的速度
    private float currentSpeed;


    [Header("Attack / Dash")]
    // 多久發動一次衝刺
    [SerializeField] private float attackInterval = 2f;

    // 旋轉一圈所需時間
    [SerializeField] private float rotateDuration = 0.5f;

    // 衝刺速度
    [SerializeField] private float dashSpeed = 8f;

    // Z 軸旋轉速度曲線
    [SerializeField] private AnimationCurve rotationCurve =
        AnimationCurve.EaseInOut(0f, 0f, 1f, 1f);


    [Header("Camera Edge")]
    // 攝影機邊緣往外擴張多少世界單位
    [SerializeField] private float cameraEdgePadding = 2f;


    [Header("Slow")]
    [SerializeField] private string slowBulletTag = "SlowBullet";

    // 減速百分比
    [SerializeField, Range(0f, 100f)]
    private float slowPercent = 25f;

    // 是否已經被減速
    private bool isSlowed = false;


    private Rigidbody2D rb;
    private Transform target;
    private Camera mainCamera;

    // 敵人目前的移動方向
    private Vector2 moveDirection = Vector2.right;

    // 攻擊計時器
    private float attackTimer;

    // 是否正在旋轉
    private bool isRotating = false;

    // 是否正在衝刺
    private bool isDashing = false;


    // =========================================================
    // 衝刺相關
    // =========================================================

    // 衝刺開始時玩家的位置
    private Vector2 dashTargetPosition;

    // 是否已經經過玩家在衝刺開始時的位置
    private bool hasPassedTargetPosition = false;


    private void Awake()
    {
        rb = GetComponent<Rigidbody2D>();

        // 初始速度
        currentSpeed = speed;

        // 找攝影機
        mainCamera = Camera.main;


        // 自動尋找名為 mizuki 的物件
        FindTarget();


        // 讓敵人一生成就開始計時
        attackTimer = attackInterval;
    }


    private void FixedUpdate()
    {
        // 沒有玩家
        if (target == null)
        {
            FindTarget();

            rb.velocity = Vector2.zero;
            return;
        }


        // =========================
        // 正在旋轉
        // =========================

        if (isRotating)
        {
            rb.velocity = Vector2.zero;
            return;
        }


        // =========================
        // 正在衝刺
        // =========================

        if (isDashing)
        {
            Dash();
            return;
        }


        // =========================
        // 一般追蹤玩家
        // =========================

        moveDirection =
            ((Vector2)target.position - rb.position).normalized;

        rb.velocity = moveDirection * currentSpeed;


        // =========================
        // 攻擊計時
        // =========================

        attackTimer -= Time.fixedDeltaTime;

        if (attackTimer <= 0f)
        {
            // 停止移動
            rb.velocity = Vector2.zero;

            // 開始旋轉
            StartCoroutine(AttackSequence());
        }
    }


    // =========================================================
    // 攻擊流程
    // =========================================================

    private IEnumerator AttackSequence()
    {
        // 避免重複執行
        if (isRotating || isDashing)
        {
            yield break;
        }


        isRotating = true;

        // 停止移動
        rb.velocity = Vector2.zero;


        // =========================
        // Z 軸旋轉一圈
        // =========================

        float timer = 0f;

        while (timer < rotateDuration)
        {
            timer += Time.deltaTime;

            float progress =
                Mathf.Clamp01(
                    timer / rotateDuration
                );


            // 使用 AnimationCurve 控制旋轉
            float curveValue =
                rotationCurve.Evaluate(progress);


            // 旋轉 360 度
            float angle =
                curveValue * 360f;


            transform.rotation =
                Quaternion.Euler(
                    0f,
                    0f,
                    angle
                );


            yield return null;
        }


        // =========================
        // 旋轉結束
        // =========================

        transform.rotation =
            Quaternion.Euler(
                0f,
                0f,
                0f
            );


        // =========================
        // 重新尋找玩家
        // =========================

        FindTarget();


        if (target != null)
        {
            // =========================================
            // 記錄玩家目前位置
            // =========================================

            dashTargetPosition =
                target.position;


            // 計算衝刺方向
            moveDirection =
                (dashTargetPosition - rb.position)
                .normalized;
        }


        // =========================================
        // 重置「經過玩家位置」判定
        // =========================================

        hasPassedTargetPosition = false;


        // 結束旋轉
        isRotating = false;


        // =========================
        // 開始衝刺
        // =========================

        isDashing = true;

        rb.velocity =
            moveDirection * dashSpeed;
    }


    // =========================================================
    // 衝刺
    // =========================================================

    private void Dash()
    {
        // 保持直線衝刺
        rb.velocity =
            moveDirection * dashSpeed;


        // =====================================================
        // 第一階段：
        // 先確認是否已經經過玩家原本的位置
        // =====================================================

        if (!hasPassedTargetPosition)
        {
            CheckPassedTargetPosition();

            // 尚未經過玩家位置
            // 所以這裡不能檢查攝影機邊緣
            return;
        }


        // =====================================================
        // 第二階段：
        // 已經經過玩家位置後，才開始檢查攝影機邊緣
        // =====================================================

        if (IsOutsideCamera())
        {
            StopDash();
        }
    }


    // =========================================================
    // 判斷是否已經經過玩家原本的位置
    // =========================================================

    private void CheckPassedTargetPosition()
    {
        // 計算敵人目前位置
        Vector2 currentPosition =
            rb.position;


        // 判斷敵人是否已經通過玩家位置
        //
        // 使用「距離」判斷：
        // 如果敵人現在距離玩家原本位置
        // 已經比開始衝刺時更近，代表正在接近。
        //
        // 當敵人通過該位置後，
        // 距離會再次開始增加。

        float currentDistance =
            Vector2.Distance(
                currentPosition,
                dashTargetPosition
            );


        float startDistance =
            Vector2.Distance(
                rb.position - moveDirection,
                dashTargetPosition
            );


        // 更可靠的方式：
        // 使用點積判斷是否已經越過目標位置
        Vector2 fromStart =
            dashTargetPosition - currentPosition;


        // 如果敵人已經位於玩家位置的前方
        // 就代表已經越過玩家
        float dot =
            Vector2.Dot(
                moveDirection,
                dashTargetPosition - currentPosition
            );


        if (dot < 0f)
        {
            hasPassedTargetPosition = true;

            Debug.Log(
                gameObject.name +
                " 已經經過衝刺開始時玩家的位置"
            );
        }
    }


    // =========================================================
    // 檢查攝影機邊緣
    // =========================================================

    private bool IsOutsideCamera()
    {
        if (mainCamera == null)
        {
            return false;
        }


        Vector3 viewportPosition =
            mainCamera.WorldToViewportPoint(
                transform.position
            );


        // =====================================================
        // 將攝影機範圍往外擴張
        // =====================================================

        // 攝影機高度
        float cameraHeight =
            mainCamera.orthographicSize * 2f;


        // 攝影機寬度
        float cameraWidth =
            cameraHeight * mainCamera.aspect;


        // 攝影機中心
        Vector3 cameraCenter =
            mainCamera.transform.position;


        // 攝影機實際世界座標邊界
        float left =
            cameraCenter.x -
            cameraWidth / 2f -
            cameraEdgePadding;


        float right =
            cameraCenter.x +
            cameraWidth / 2f +
            cameraEdgePadding;


        float bottom =
            cameraCenter.y -
            cameraHeight / 2f -
            cameraEdgePadding;


        float top =
            cameraCenter.y +
            cameraHeight / 2f +
            cameraEdgePadding;


        Vector2 enemyPosition =
            transform.position;


        // 左
        if (enemyPosition.x <= left)
        {
            return true;
        }


        // 右
        if (enemyPosition.x >= right)
        {
            return true;
        }


        // 下
        if (enemyPosition.y <= bottom)
        {
            return true;
        }


        // 上
        if (enemyPosition.y >= top)
        {
            return true;
        }


        return false;
    }


    // =========================================================
    // 停止衝刺
    // =========================================================

    private void StopDash()
    {
        isDashing = false;

        rb.velocity = Vector2.zero;


        // 重新開始攻擊計時
        attackTimer = attackInterval;
    }


    // =========================================================
    // 尋找玩家
    // =========================================================

    private void FindTarget()
    {
        GameObject mizukiObject =
            GameObject.Find("mizuki");


        if (mizukiObject != null)
        {
            target =
                mizukiObject.transform;
        }
        else
        {
            target = null;

            Debug.LogError(
                "找不到名為 mizuki 的物件！"
            );
        }
    }


    // =========================================================
    // Trigger
    // =========================================================

    private void OnTriggerEnter2D(Collider2D other)
    {
        // 減速子彈
        if (other.CompareTag(slowBulletTag))
        {
            SlowEnemy();
        }
    }


    // =========================================================
    // 減速
    // =========================================================

    private void SlowEnemy()
    {
        // 已經減速就不重複計算
        if (isSlowed)
        {
            return;
        }


        isSlowed = true;


        // 例如 3 × 0.75 = 2.25
        currentSpeed =
            speed *
            (1f - slowPercent / 100f);


        Debug.Log(
            gameObject.name +
            " 被減速！目前速度：" +
            currentSpeed
        );
    }
}