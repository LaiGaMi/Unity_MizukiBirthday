using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class Player_Att05 : MonoBehaviour
{
    [Header("預置物")]
    public GameObject bullet01;
    public GameObject bullet02;
    public GameObject bullet04;

    [Header("敵人 Tag")]
    public string enemyTag = "Enemy";

    [Header("攻擊間隔")]
    public float attackInterval = 1f;

    private float attackTimer = 0f;


    private void Update()
    {
        // 沒有技能
        if (mizuki.att06 <= 0)
        {
            return;
        }

        // 攻擊計時
        attackTimer += Time.deltaTime;

        if (attackTimer >= attackInterval)
        {
            Attack();

            attackTimer = 0f;
        }
    }


    private void Attack()
    {
        GameObject attackPrefab = null;
        int targetCount = 0;


        // =========================================
        // 根據技能等級決定預置物與目標數量
        // =========================================

        switch (mizuki.att06)
        {
            case 1:

                // Level 1
                attackPrefab = bullet01;
                targetCount = 1;

                break;


            case 2:

                // Level 2
                attackPrefab = bullet02;
                targetCount = 2;

                break;


            case 3:

                // Level 3
                attackPrefab = bullet04;
                targetCount = 3;

                break;
        }


        // 沒有預置物
        if (attackPrefab == null)
        {
            return;
        }


        // =========================================
        // 搜尋所有敵人
        // =========================================

        GameObject[] enemies = GameObject.FindGameObjectsWithTag(enemyTag);


        // 場上沒有敵人
        if (enemies.Length == 0)
        {
            return;
        }


        // =========================================
        // 建立可選擇的敵人清單
        // =========================================

        List<GameObject> availableEnemies =
            new List<GameObject>(enemies);


        // =========================================
        // 隨機選擇敵人
        // =========================================

        for (int i = 0; i < targetCount; i++)
        {
            // 已經沒有敵人可以選
            if (availableEnemies.Count == 0)
            {
                break;
            }


            // 隨機選一個
            int randomIndex =
                Random.Range(0, availableEnemies.Count);


            GameObject target =
                availableEnemies[randomIndex];


            // =========================================
            // 在敵人位置生成預置物
            // =========================================

            Instantiate(
                attackPrefab,
                target.transform.position,
                Quaternion.identity
            );


            // =========================================
            // 從可選清單移除
            // 避免同一個敵人被選兩次
            // =========================================

            availableEnemies.RemoveAt(randomIndex);
        }
    }
}